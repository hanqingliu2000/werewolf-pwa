{
  "name": "werewolf-pwa",
  "private": true,
  "scripts": {
    "dev:werewolf": "npm --prefix web run dev",
    "build:werewolf": "npm --prefix web run build",
    "typecheck:werewolf": "npm --prefix web run typecheck",
    "test:werewolf": "npm --prefix web exec vitest -- run --root web --no-file-parallelism",
    "e2e:werewolf": "npm --prefix web run e2e",
    "smoke:werewolf": "npm --prefix web exec vitest -- run --root web tests/me-view.test.ts tests/route-privacy.test.ts --no-file-parallelism",
    "smoke:supabase": "node scripts/supabase-smoke.mjs --skip-missing-env",
    "smoke:supabase:rpc": "node scripts/supabase-smoke.mjs --rpc-flow",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "check:audio": "node scripts/check-host-audio.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  }
}
