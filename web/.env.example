# Local development only. No cloud credentials are required.
WEREWOLF_STORAGE=sqlite
WEREWOLF_DB_PATH=.data/rooms.sqlite
WEREWOLF_ORIGIN=http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1

# Production must use postgres and the environment-specific private schema.
# Configure WEREWOLF_DATABASE_URL and WEREWOLF_DATABASE_CA in the platform's
# secret settings. Never put real credentials in this file or NEXT_PUBLIC_*.
# WEREWOLF_SCHEMA=werewolf_prod
# WEREWOLF_MAINTENANCE=1
